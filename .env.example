DJANGO_SECRET_KEY=dev-emakon-change-me-please-use-64-chars-minimum-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.local

USE_SQLITE=True

POSTGRES_DB=emakon
POSTGRES_USER=emakon
POSTGRES_PASSWORD=emakon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dev OTP: agar True bo'lsa, SMS o'rniga OTP response'da qaytariladi
OTP_DEBUG_RETURN_CODE=True
OTP_CODE_TTL_SECONDS=300
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT=5
OTP_REQUEST_RATE_WINDOW_SECONDS=600

DEFAULT_ORGANIZATION_NAME=E-Makon

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
NOTIFICATION_QUEUE_KEY=emakon:notifications

# Trusted Telegram bot ↔ API credential (required for /auth/telegram/link/)
EMAKON_BOT_SERVICE_KEY=change-me-bot-service-key

# Optional SMS provider (empty = stub; set for production)
SMS_PROVIDER=
SMS_API_URL=
SMS_API_TOKEN=

# --- Telegram Bot (separate process) ---
BOT_TOKEN=
EMAKON_API_BASE_URL=http://127.0.0.1:8000/api/v1
BOT_SECRET_KEY=change-me-bot-encryption-key
BOT_DATABASE_PATH=bot_data/sessions.sqlite3
BOT_RUN_MODE=polling
# Local: allow bot without Redis (FSM in-memory; notifications disabled until Redis is up)
BOT_ALLOW_MEMORY_FSM=true
BOT_USE_REDIS=false
# Agar Telegram API bloklangan bo'lsa (UZ): socks5://user:pass@host:port yoki http://host:port
TELEGRAM_PROXY=
TELEGRAM_TIMEOUT=25
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram/webhook
BOT_HOST=0.0.0.0
BOT_PORT=8081

# Legacy flag unused by E-Makon runtime (do not enable MyGarden coupling)
MYGARDEN_SHARED_MODE=False
